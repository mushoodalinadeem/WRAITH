# Copy to .env and fill in real values. Never commit .env.

WRAITH_ENV=production
SECRET_KEY=replace-with-a-long-random-string
DASHBOARD_USERNAME=operator
DASHBOARD_PASSWORD=replace-with-12-plus-chars

# Set true when the dashboard is served over HTTPS
SESSION_COOKIE_SECURE=false

# Optional: allow the dashboard Simulate button (off in production by default)
ENABLE_DEMO=false

FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# WRAITH_DB_PATH=/app/data/wraith.db
# WRAITH_MODEL_PATH=/app/ml/model.pkl
